// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.robertofdzb10.ffmpeggui",
  "asar": true,
  "productName": "FFmpeg GUI",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron"
  ],
  // Solo se distribuye para Windows: scripts/build-backend.cjs empaqueta el
  // backend con PyInstaller asumiendo venv/Scripts/python.exe y produce un
  // .exe; en mac/linux ni encuentra ese intérprete ni el binario resultante
  // tendría esa extensión, así que esos targets fallarían o generarían un
  // paquete sin backend funcional. Si se quiere soporte multiplataforma,
  // build-backend.cjs necesita generalizarse primero.
  "extraResources": [
    {
      "from": "backend-dist/ffmpeg-cli-bridge",
      "to": "logic/ffmpeg-cli-bridge"
    }
  ],
  "win": {
    "icon": "public/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    // Sin espacios: GitHub cambia los espacios de los assets por puntos y
    // latest.yml dejaría de apuntar al instalador correcto.
    "artifactName": "FFmpeg-GUI-Windows-${version}-Setup.${ext}"
  },
  // Actualizaciones automáticas (electron-updater): la app instalada consulta
  // la última Release de este repositorio. Cada release debe llevar el
  // instalador, su .blockmap y latest.yml (los genera `npm run build` en
  // release/<versión>/).
  "publish": [
    {
      "provider": "github",
      "owner": "robertofdzb10",
      "repo": "ffmpeg-interfaz"
    }
  ],
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  }
}
